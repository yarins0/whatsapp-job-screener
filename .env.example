# -- Required ----------------------------------------------------------------
# Get yours at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# -- WhatsApp groups to watch ------------------------------------------------
# Comma-separated group IDs in the form 120363XXXXXXXXXX@g.us
# Leave empty on first run -- the listener will print all your group IDs.
WATCHED_GROUPS=

# -- Telegram notifications (optional but recommended) -----------------------
# Create a bot with @BotFather on Telegram to get the token.
# Get your chat ID by messaging the bot and calling:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- LangSmith tracing (optional) --------------------------------------------
# Free account at https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=whatsapp-job-screener

# -- Advanced ----------------------------------------------------------------
# Override the SQLite database path (defaults to db/jobs.db)
# JOBS_DB_PATH=db/jobs.db

# URL the WhatsApp listener posts messages to (defaults to localhost:8000)
# INGEST_API_URL=http://localhost:8000/ingest
