# Copy to .env and fill in real values. Never commit .env.

# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith tracing (free tier) — https://smith.langchain.com/
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=whatsapp-job-screener

# Telegram digest delivery (optional). Leave blank to disable.
# Create a bot via @BotFather, then start a chat and grab your chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local paths
JOBS_DB_PATH=db/jobs.db
INGEST_API_URL=http://localhost:8000/ingest

#Whatsapp groups to watch, comma-separated. Must match the group name exactly.
WATCHED_GROUPS=Group Name 1,Group Name 2 