# -- Required ----------------------------------------------------------------
# Get yours at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# -- Telegram bot (optional but recommended) ---------------------------------
# Create a bot with @BotFather on Telegram to get the token.
# Get your chat ID by messaging the bot and calling:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Telegram source listener (optional) -------------------------------------
# Lets the agent read messages from Telegram channels and groups as a job source.
# Get api_id and api_hash from https://my.telegram.org -> API Development Tools.
# First run will prompt for an SMS verification code; session is saved afterwards.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# -- Web scraper (optional) --------------------------------------------------
# How often to poll AllJobs / Indeed for new listings (default: 30 minutes).
# WEB_SCRAPER_INTERVAL_MINUTES=30

# -- LangSmith tracing (optional) --------------------------------------------
# Free account at https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=job-screening-agent

# -- Advanced ----------------------------------------------------------------
# Override the SQLite database path (defaults to db/jobs.db)
# JOBS_DB_PATH=db/jobs.db

# URL all listeners post messages to (defaults to localhost:8000)
# INGEST_API_URL=http://localhost:8000/ingest
